<Page
    x:Class="Eden.UwpPorting.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="LoadKeysButton" Content="Load Keys" Click="OnLoadKeysClicked" MinWidth="140" />
            <Button x:Name="LoadGameButton" Content="Load Game" Click="OnLoadGameClicked" MinWidth="140" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,16" BorderBrush="Gray" BorderThickness="1">
            <SwapChainPanel x:Name="RenderPanel" />
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready." />
    </Grid>
</Page>
