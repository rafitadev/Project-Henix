<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>uap10.0.19041</TargetFramework>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <OutputType>AppContainerExe</OutputType>
    <RootNamespace>Eden.UwpPorting</RootNamespace>
    <ApplicationManifest>Package.appxmanifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <UseWinUI>false</UseWinUI>
    <DefineConstants>$(DefineConstants);EDEN_UWP;CPU_INTERPRETER_ONLY;GPU_D3D12</DefineConstants>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.6" />
    <PackageReference Include="Vortice.Windows" Version="3.6.2" />
      <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>
</Project>
